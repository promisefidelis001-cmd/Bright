/* --------------------------------------------------------
   Simple reset / base
   -------------------------------------------------------- */
:root{
  /* Color palette (dark-blue theme) */
  --bg:#071a2b;           /* very dark blue background */
  --panel:#0b3a66;        /* deep blue panels */
  --accent:#1ea7ff;       /* bright blue accent */
  --muted:#98aac0;        /* muted light text */
  --text:#e8f2fb;         /* primary text color */
  --glass: rgba(255,255,255,0.04); /* subtle overlay */
  --radius:12px;
  --container-max:1100px;
  --gap:1rem;
  --transition:200ms cubic-bezier(.2,.8,.2,1);
}

*,
*::before,
*::after{box-sizing:border-box;margin:0;padding:0}

/* Use system UI fonts for good performance */
html,body{
  height:100%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  background:linear-gradient(180deg,var(--bg), #042131 120%);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.45;
  scroll-behavior:smooth; /* smooth scrolling for anchor links */
  padding:0;
}

/* Utility container to center content and limit width */
.container{
  width:100%;
  max-width:var(--container-max);
  margin:0 auto;
  padding:0 1rem;
}

/* Small helpers */
.visually-hidden{
  position:absolute!important;
  height:1px;width:1px;
  overflow:hidden;clip:rect(1px,1px,1px,1px);
  white-space:nowrap;border:0;padding:0;margin:-1px;
}

/* --------------------------------------------------------
   Header & navigation (mobile-first)
   -------------------------------------------------------- */
.site-header{
  background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);
  position:sticky;top:0;z-index:60;
  backdrop-filter: blur(6px);
  border-bottom:1px solid rgba(255,255,255,0.03);
}

.header-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:var(--gap);
  padding:0.8rem 0;
}

/* Logo / site title */
.logo{
  font-weight:700;
  color:var(--text);
  text-decoration:none;
  font-size:1.05rem;
  letter-spacing:0.2px;
}

/* Mobile hamburger button */
.menu-toggle{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:.25rem;
  background:transparent;
  border:1px solid transparent;
  padding:0.4rem;
  border-radius:8px;
  cursor:pointer;
  transition:var(--transition);
}
.menu-toggle:focus{
  outline:3px solid rgba(30,167,255,0.18);
  outline-offset:2px;
}

/* Hamburger lines */
.hamburger-line{
  display:block;
  width:20px;height:2px;
  background:var(--text);
  border-radius:2px;
  transition:transform 180ms ease, opacity 120ms ease;
}

/* Navigation - hidden by default on small screens */
.main-nav{
  position: absolute;
  right:1rem;
  top:64px;
  width:calc(100% - 2rem);
  max-width:360px;
  background:linear-gradient(180deg,var(--panel), rgba(11,58,102,0.9));
  border-radius:10px;
  padding:0.75rem;
  box-shadow:0 6px 20px rgba(2,6,23,0.6);
  display:none;
  flex-direction:column;
  gap:0.5rem;
  transform-origin:top right;
  transition:transform var(--transition),opacity var(--transition);
}
.main-nav a{
  color:var(--text);
  text-decoration:none;
  padding:0.5rem 0.6rem;
  border-radius:8px;
  display:block;
  font-weight:600;
}
.main-nav a:hover,
.main-nav a:focus{
  background:var(--glass);
  color:var(--accent);
}

/* When menu is expanded, JS will add [aria-expanded="true"] to button.
   We'll use a simple class on the nav to show it — script.js will toggle .open */
.main-nav.open{display:flex;opacity:1;transform:translateY(0);}

/* --------------------------------------------------------
   Hero
   -------------------------------------------------------- */
.hero{
  padding:3.5rem 0 2.5rem;
  background:
    radial-gradient(600px 200px at 10% 10%, rgba(30,167,255,0.06), transparent 12%),
    linear-gradient(180deg, transparent, rgba(255,255,255,0.01));
}
.hero-inner{
  text-align:left;
  padding:0.5rem 0;
}
.site-title{
  font-size:1.6rem;
  margin-bottom:0.4rem;
  color:var(--text);
}
.lead{
  color:var(--muted);
  margin-bottom:0.8rem;
}
.btn{
  display:inline-block;
  background:linear-gradient(90deg,var(--accent), #3bd1ff);
  color: #032033;
  padding:0.6rem 0.9rem;
  border-radius:10px;
  text-decoration:none;
  font-weight:700;
  box-shadow:0 6px 18px rgba(30,167,255,0.12);
  transition:transform var(--transition), box-shadow var(--transition);
}
.btn:hover,
.btn:focus{ transform:translateY(-3px); box-shadow:0 10px 24px rgba(30,167,255,0.18); }

/* --------------------------------------------------------
   Sections, headings, and content
   -------------------------------------------------------- */
section{
  padding:1.5rem 0;
}
h2{
  font-size:1.1rem;
  margin-bottom:0.6rem;
  color:var(--text);
}
p{ color:var(--muted); margin-bottom:0.6rem; }

